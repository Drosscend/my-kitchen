# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database (compose.yaml starts a matching Postgres locally)
DATABASE_URL=postgres://my_kitchen:password@localhost:5432/my_kitchen

# Session
SESSION_DRIVER=cookie

# Mail. Locally, compose.yaml starts Mailpit: SMTP on 1025, inbox on
# http://localhost:8025. In production the SMTP relay is reached on a
# private Docker network, see docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=my-kitchen@kevin-dev.com
MAIL_FROM_NAME=Mon Garde-Manger

# Umami analytics (optional, tracking script URL of the instance)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# When set, the detailed /health report requires this value in the
# x-monitoring-secret header; other callers get a bare status
MONITORING_SECRET=
