{
  "name": "my-kitchen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test unit functional",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "db:codegen": "kysely-codegen --dialect postgres --env-file .env --out-file types/db.ts",
    "db:migrate": "node ace migrate",
    "db:fresh": "node ace migrate:fresh",
    "db:rollback": "node ace migrate:rollback",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./src/core/*.js",
    "#identity/*": "./src/identity/*.js",
    "#shared/*": "./src/shared/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#types/*": "./types/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.1",
    "@base-ui/react": "^1.8.0",
    "@fontsource/kalam": "^5.3.0",
    "@inertiajs/react": "^3.7.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "edge.js": "^6.5.1",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^3.0.0",
    "lucide-react": "^1.28.0",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@oxlint/plugins": "^1.79.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "~26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "hot-hook": "^1.0.0",
    "kysely-codegen": "^0.20.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/*.ts"
    ]
  }
}
