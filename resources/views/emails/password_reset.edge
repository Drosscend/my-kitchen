@email.layout({ title: subject, preheader, logoUrl })
  <h1
    style="margin: 0 0 16px; font-size: 27px; line-height: 1.15; font-weight: 800; font-stretch: 80%; letter-spacing: -0.01em"
  >
    Un <span style="background-color: #fbecb8; background-image: linear-gradient(#fffefb 40%, #f6d877 40%); padding: 0 2px">nouveau mot de passe</span> ?
  </h1>
  <p style="margin: 0">
    Quelqu'un, sans doute toi, a demandé à réinitialiser le mot de passe de ton compte.
  </p>
  @email.button({ href: url })
    Choisir un nouveau mot de passe
  @end
  <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #6b6155">
    Le lien est valable 1 heure et ne sert qu'une fois. Si tu n'es pas à l'origine de cette
    demande, ignore ce message : ton mot de passe actuel reste valable.
  </p>
  @!email.fallback({ href: url })
@end
