@email.layout({
  title: subject,
  preheader,
  logoUrl,
  footer: 'Mail de sécurité, envoyé à chaque changement sensible sur ton compte.',
})
  <h1
    style="margin: 0 0 16px; font-size: 27px; line-height: 1.15; font-weight: 800; font-stretch: 80%; letter-spacing: -0.01em"
  >
    <span style="background-color: #fbecb8; background-image: linear-gradient(#fffefb 40%, #f6d877 40%); padding: 0 2px">{{ clientName }}</span> a accès à ton garde-manger
  </h1>
  <p style="margin: 0">Tu viens d'autoriser une application à utiliser ton compte.</p>
  @!email.facts({
    rows: [
      { label: 'Application', value: clientName },
      { label: 'Autorisée le', value: date },
      { label: 'Accès', value: 'Lire et modifier ton inventaire et tes recettes' },
    ],
  })
  @email.alert({ title: "Ce n'est pas toi ?" })
    Retire l'accès depuis ta page compte, puis change ton mot de passe.
  @end
  @email.button({ href: accountUrl })
    Gérer les applications connectées
  @end
@end
