@email.layout({ title: subject, preheader, logoUrl })
  @slot('footer')
    Mail de sécurité, envoyé à chaque changement sensible sur ton compte.
  @end
  <h1
    style="margin: 0 0 16px; font-size: 27px; line-height: 1.15; font-weight: 800; font-stretch: 80%; letter-spacing: -0.01em"
  >
    Ton <span style="background-color: #fbecb8; background-image: linear-gradient(#fffefb 40%, #f6d877 40%); padding: 0 2px">adresse e-mail</span> a changé
  </h1>
  <p style="margin: 0">
    Ce mail part à ton ancienne adresse, au cas où ce changement ne viendrait pas de toi.
  </p>
  @!email.facts({
    rows: [
      { label: 'Ancienne', value: previousEmail },
      { label: 'Nouvelle', value: newEmail },
      { label: 'Le', value: date },
    ],
  })
  @email.alert({ title: "Ce n'est pas toi ?" })
    Réponds à ce mail pour qu'on bloque le compte.
  @end
@end
