@email.layout({ title: subject, preheader, logoUrl })
  @slot('footer')
    Mail de sécurité, envoyé à chaque changement sensible sur ton compte.
  @end
  <h1
    style="margin: 0 0 16px; font-size: 27px; line-height: 1.15; font-weight: 800; font-stretch: 80%; letter-spacing: -0.01em"
  >
    Ton <span style="background-color: #fbecb8; background-image: linear-gradient(#fffefb 40%, #f6d877 40%); padding: 0 2px">mot de passe</span> a été modifié
  </h1>
  @!email.facts({ rows: [{ label: 'Le', value: date }, { label: 'Compte', value: email }] })
  @email.alert({ title: "Ce n'est pas toi ?" })
    Réinitialise ton mot de passe tout de suite : le lien arrive sur cette adresse.
  @end
  @email.button({ href: resetUrl })
    Réinitialiser mon mot de passe
  @end
@end
