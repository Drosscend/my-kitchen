@email.layout({ title: subject, preheader, logoUrl })
  @slot('footer')
    Tu reçois ce mail car les alertes de péremption sont activées.<br />
    <a href="{{ settingsUrl }}" style="color: #2a4290">Se désabonner</a>
  @end
  <p
    style="margin: 0 0 6px; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6b6155"
  >
    {{ date }}
  </p>
  <h1
    style="margin: 0 0 20px; font-size: 27px; line-height: 1.15; font-weight: 800; font-stretch: 80%; letter-spacing: -0.01em"
  >
    Ce matin dans ton <span style="background-color: #fbecb8; background-image: linear-gradient(#fffefb 40%, #f6d877 40%); padding: 0 2px">garde-manger</span>
  </h1>
  @each(section in sections)
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="margin: 0 0 18px"
    >
      <tr>
        <td colspan="2" style="padding: 0 0 4px">
          <span
            style="display: inline-block; width: 12px; height: 12px; border-radius: 6px; background-color: {{ section.dot }}; vertical-align: -1px"
          ></span>
          <span
            style="padding-left: 6px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase"
            >{{ section.title }}</span
          >
        </td>
      </tr>
      @each(item in section.items)
        <tr>
          <td style="padding: 9px 12px 9px 20px; border-bottom: 1px solid #dce3f0">
            <strong style="font-weight: 600">{{ item.name }}</strong><br />
            <span style="font-size: 13px; color: #6b6155">{{ item.detail }}</span>
          </td>
          <td
            align="right"
            style="padding: 9px 0; border-bottom: 1px solid #dce3f0; white-space: nowrap"
          >
            <span
              style="display: inline-block; padding: 3px 8px; border-radius: 6px; background-color: {{ section.stampBackground }}; color: {{ section.stampColor }}; font-size: 12px; font-weight: 700"
              >{{ item.stamp }}</span
            >
          </td>
        </tr>
      @end
    </table>
  @end
  @email.button({ href: inventoryUrl })
    Ouvrir mon garde-manger
  @end
  <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #6b6155">
    Seuls les lots qui ont changé de statut depuis le dernier point apparaissent ici.
  </p>
@end
