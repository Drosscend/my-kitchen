<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="margin: 20px 0; border-top: 1px solid #dce3f0; font-size: 14px; line-height: 1.5"
>
  @each(row in rows)
    <tr>
      <td
        width="120"
        valign="top"
        style="padding: 9px 12px 9px 0; border-bottom: 1px solid #dce3f0; color: #6b6155"
      >
        {{ row.label }}
      </td>
      <td
        valign="top"
        style="padding: 9px 0; border-bottom: 1px solid #dce3f0; font-weight: 600; word-break: break-word"
      >
        {{ row.value }}
      </td>
    </tr>
  @end
</table>
