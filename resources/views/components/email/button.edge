<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0">
  <tr>
    <td
      bgcolor="#2a4290"
      style="background-color: #2a4290; border-radius: 10px; border-bottom: 2px solid #1c2d63"
    >
      <a
        href="{{ href }}"
        style="display: inline-block; padding: 12px 22px; font-size: 15px; font-weight: 600; line-height: 1.2; color: #ffffff; text-decoration: none"
      >
        {{{ await $slots.main() }}}
      </a>
    </td>
  </tr>
</table>
